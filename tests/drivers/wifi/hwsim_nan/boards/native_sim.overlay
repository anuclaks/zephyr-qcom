/ {
	sta: wifi-sta {
		compatible = "zephyr,wifi-hwsim";
		radio-index = <0>;
		local-mac-address = [02 00 00 00 00 01];
	};

	nan: wifi-nan {
		compatible = "zephyr,wifi-hwsim";
		radio-index = <1>;
		local-mac-address = [02 00 00 00 00 02];
		nan-management;
	};
};
